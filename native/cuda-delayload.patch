+    # Keep optional cuBLAS code unmapped until its first actual call on Windows.
+    # This changes loader behavior only; CUDA kernels and the public ABI stay intact.
+    if (WIN32 AND MSVC)
+        target_link_options(ggml-cuda PRIVATE "/DELAYLOAD:cublas64_12.dll")
+        target_link_libraries(ggml-cuda PRIVATE delayimp)
+    endif()
