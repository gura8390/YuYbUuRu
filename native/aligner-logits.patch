+}
+
+llama_context * caps_llama_init_from_model_with_logits_limit(
+        llama_model * model, llama_context_params params, uint32_t logits_limit) {
+    if (!model || model->arch != LLM_ARCH_QWEN3VL || !model->hparams.causal_attn ||
+            logits_limit == 0 || logits_limit > (uint32_t) model->vocab.n_tokens() ||
+            params.embeddings || params.n_samplers != 0 || params.samplers != nullptr ||
+            (params.pooling_type != LLAMA_POOLING_TYPE_NONE && params.pooling_type != LLAMA_POOLING_TYPE_UNSPECIFIED) ||
+            params.attention_type == LLAMA_ATTENTION_TYPE_NON_CAUSAL || !model->loras.empty()) {
+        LLAMA_LOG_ERROR("%s: requires a causal Qwen3VL alignment context, valid width, no embeddings/adapters/samplers\n", __func__);
+        return nullptr;
+    }
+    if (logits_limit != (uint32_t) model->vocab.n_tokens() && logits_limit % 16 != 0) {
+        LLAMA_LOG_ERROR("%s: limited output width must be a multiple of 16 for CPU repack compatibility\n", __func__);
+        return nullptr;
+    }
+    for (const auto & device : model->devices) {
+        if (ggml_backend_dev_type(device.dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            LLAMA_LOG_ERROR("%s: this experiment only supports CPU alignment models\n", __func__);
+            return nullptr;
+        }
+    }
+    const ggml_tensor * output = model->output;
+    if (!output || !output->buffer || output->ne[0] != model->hparams.n_embd ||
+            output->ne[1] != model->vocab.n_tokens() || output->ne[2] != 1 || output->ne[3] != 1) {
+        LLAMA_LOG_ERROR("%s: unexpected output projection shape or missing weight buffer\n", __func__);
+        return nullptr;
+    }
+    LLAMA_LOG_INFO("%s: output weight type=%s buffer=%s shape=[%lld,%lld] row_stride=%zu view_offset=0\n", __func__,
+            ggml_type_name(output->type), ggml_backend_buffer_name(output->buffer),
+            (long long) output->ne[0], (long long) output->ne[1], output->nb[1]);
+    LLAMA_LOG_INFO("%s: output width %u of %u; model vocabulary and weights unchanged\n", __func__,
+            logits_limit, (uint32_t) model->vocab.n_tokens());
+    return caps_init_context_impl(model, params, logits_limit);
+}
+
+uint32_t caps_llama_logits_width(const llama_context * ctx) {
+    return ctx ? ctx->logits_width() : 0;
 }
 
